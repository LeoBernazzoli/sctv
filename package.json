{
  "name": "sctv",
  "version": "0.2.0",
  "description": "Interfaccia TV per StreamingCommunity: catalogo, ricerca, lista personale, stagioni ed episodi.",
  "repository": {
    "type": "git",
    "url": "https://github.com/LeoBernazzoli/sctv.git"
  },
  "appName": "SC TV",
  "packageType": "mods",
  "websiteURL": "https://streamingcommunityz.boo/en",
  "main": "src/tv.js",
  "evaluateScriptOnDocumentStart": false,
  "keys": [
    "Info",
    "ColorF3Blue",
    "MediaPlayPause",
    "MediaPlay",
    "MediaPause",
    "MediaStop",
    "MediaFastForward",
    "MediaRewind"
  ],
  "files": [
    "src/tv.js",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.cjs",
    "check": "node scripts/build.cjs && node --check src/tv.js",
    "pretest": "node scripts/build.cjs",
    "test": "node --test test/*.test.cjs"
  },
  "devDependencies": {
    "jsdom": "26.1.0"
  }
}
